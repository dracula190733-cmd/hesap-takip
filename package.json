import React, { useEffect, useMemo, useState } from 'react';
import {
  AlertTriangle,
  BellRing,
  Download,
  FileSpreadsheet,
  FileText,
  LayoutDashboard,
  Lock,
  PieChart as PieChartIcon,
  Plus,
  Search,
  Settings,
  ShieldCheck,
  Smartphone,
  UserRound,
  Ban,
  BadgeCheck,
} from 'lucide-react';
import {
  ResponsiveContainer,
  AreaChart,
  Area,
  CartesianGrid,
  XAxis,
  YAxis,
  Tooltip,
  PieChart,
  Pie,
  Cell,
} from 'recharts';

const APP_TIME_ZONE = 'Europe/Istanbul';
const STORAGE_USERS = 'set-panel-users-v1';

function getTurkeyNow() {
  const now = new Date();
  const parts = new Intl.DateTimeFormat('en-CA', {
    timeZone: APP_TIME_ZONE,
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit',
    hour12: false,
  }).formatToParts(now);
  const get = (type) => parts.find((p) => p.type === type)?.value || '00';
  return {
    date: `${get('year')}-${get('month')}-${get('day')}`,
    dateTime: `${get('year')}-${get('month')}-${get('day')} ${get('hour')}:${get('minute')}`,
  };
}

const TODAY = getTurkeyNow().date;
const DEFAULT_ACCOUNT_NAMES = ['A HESABI','B HESABI','C HESABI','D HESABI','E HESABI','F HESABI','G HESABI','H HESABI','I HESABI','J HESABI'];

const STATUS_META = {
  pasif: { label: 'PASİF', className: 'status-passive', icon: Ban },
  aktif: { label: 'AKTİF', className: 'status-active', icon: BadgeCheck },
  nfc: { label: 'NFC', className: 'status-nfc', icon: Smartphone },
  sifre_kilit: { label: 'ŞİFRE KİLİT', className: 'status-lock', icon: Lock },
  bloke: { label: 'BLOKE', className: 'status-block', icon: AlertTriangle },
};

const SEED_PEOPLE = [
  { id: 'p1', fullName: 'AHMET YILDIZ', startDate: TODAY, accountNames: [...DEFAULT_ACCOUNT_NAMES] },
  { id: 'p2', fullName: 'MEHMET KARA', startDate: TODAY, accountNames: [...DEFAULT_ACCOUNT_NAMES] },
  { id: 'p3', fullName: 'HASAN DEMİR', startDate: TODAY, accountNames: [...DEFAULT_ACCOUNT_NAMES] },
];

const DEFAULT_USERS = [
  { id: 'u1', username: 'admin', password: 'admin123', twoFA: '000111', displayName: 'YÖNETİCİ', role: 'admin', isActive: true, canEnterData: true, isTyping: false },
  { id: 'u2', username: 'dracula', password: '123456', twoFA: '482901', displayName: 'ONUR', role: 'user', isActive: true, canEnterData: true, isTyping: true },
  { id: 'u3', username: 'cem', password: '123456', twoFA: '517224', displayName: 'CEM', role: 'user', isActive: true, canEnterData: false, isTyping: false },
];

function getStoredUsers() {
  try {
    const raw = localStorage.getItem(STORAGE_USERS);
    if (!raw) return DEFAULT_USERS;
    const parsed = JSON.parse(raw);
    return Array.isArray(parsed) && parsed.length ? parsed : DEFAULT_USERS;
  } catch {
    return DEFAULT_USERS;
  }
}

function makeDayRecords(people) {
  return people.flatMap((person) =>
    person.accountNames.map((accountName, index) => ({
      id: `${person.id}-${index + 1}`,
      personId: person.id,
      personName: person.fullName,
      accountName,
      amount: 0,
      status: 'pasif',
      note: '',
      editedBy: '',
      editedAt: '',
    }))
  );
}

function seedHistory(people) {
  return {
    [TODAY]: makeDayRecords(people).map((r, i) => ({
      ...r,
      amount: i % 4 === 0 ? 1800 : i % 5 === 0 ? 250 : 0,
      status: i % 7 === 0 ? 'bloke' : i % 6 === 0 ? 'sifre_kilit' : i % 3 === 0 ? 'nfc' : 'aktif',
      note: i % 7 === 0 ? 'İNCELEME BEKLİYOR' : '',
      editedBy: i % 2 === 0 ? 'ONUR' : 'CEM',
      editedAt: `${TODAY} 10:${String((i * 3) % 60).padStart(2, '0')}`,
    })),
    '2026-04-14': makeDayRecords(people).map((r, i) => ({
      ...r,
      amount: i % 4 === 0 ? 1200 : i % 5 === 0 ? 0 : 350,
      status: i % 7 === 0 ? 'bloke' : i % 6 === 0 ? 'sifre_kilit' : i % 3 === 0 ? 'nfc' : 'aktif',
      note: i % 7 === 0 ? 'ÖNCEKİ GÜNDEN BLOKE' : '',
      editedBy: 'ONUR',
      editedAt: '2026-04-14 22:40',
    })),
  };
}

const SEED_BLOCKS = [
  { id: 'b1', date: '2026-04-14', personName: 'AHMET YILDIZ', accountName: 'B HESABI', amount: 2400, type: 'bloke', note: 'İNCELEME BEKLİYOR', resolution: 'cozulmedi', resultList: 'merkez', createdBy: 'ONUR' },
  { id: 'b2', date: TODAY, personName: 'MEHMET KARA', accountName: 'D HESABI', amount: 950, type: 'sifre_kilit', note: 'ŞİFRE BLOKE', resolution: 'cozulmedi', resultList: 'merkez', createdBy: 'ONUR' },
];

function formatMoney(value) {
  return new Intl.NumberFormat('tr-TR', { style: 'currency', currency: 'TRY', maximumFractionDigits: 0 }).format(Number(value || 0));
}

function SummaryCard({ title, value, subtitle, onClick, tone = '' }) {
  return (
    <div className={`card summary ${tone} ${onClick ? 'clickable' : ''}`} onClick={onClick}>
      <div className="summary-title">{title}</div>
      <div className="summary-value">{value}</div>
      <div className="summary-subtitle">{subtitle}</div>
    </div>
  );
}

function StatusBadge({ status }) {
  const meta = STATUS_META[status] || STATUS_META.pasif;
  const Icon = meta.icon;
  return <span className={`badge ${meta.className}`}><Icon size={13} /> {meta.label}</span>;
}

function OverlayModal({ open, title, children, onClose, maxWidth = 720 }) {
  if (!open) return null;
  return (
    <div className="overlay">
      <div className="modal" style={{ maxWidth }}>
        <div className="modal-header">
          <div className="modal-title">{title}</div>
          <button className="icon-button" onClick={onClose}>×</button>
        </div>
        <div className="modal-body">{children}</div>
      </div>
    </div>
  );
}

export default function App() {
  const [users, setUsers] = useState(() => getStoredUsers());
  const [people, setPeople] = useState(SEED_PEOPLE);
  const [historyByDay, setHistoryByDay] = useState(() => seedHistory(SEED_PEOPLE));
  const [blockCenter, setBlockCenter] = useState(SEED_BLOCKS);
  const [currentUser, setCurrentUser] = useState(null);
  const [login, setLogin] = useState({ username: 'admin', password: 'admin123', twoFA: '000111' });
  const [selectedDay, setSelectedDay] = useState(TODAY);
  const [selectedPersonId, setSelectedPersonId] = useState('p1');
  const [activeSection, setActiveSection] = useState('genel');
  const [filter, setFilter] = useState('');
  const [showUsersPanel, setShowUsersPanel] = useState(false);
  const [selectedGeneralSummary, setSelectedGeneralSummary] = useState(null);
  const [actionNotice, setActionNotice] = useState({ open: false, title: '', message: '', tone: 'success' });
  const [notificationModalOpen, setNotificationModalOpen] = useState(false);
  const [navigationWarningOpen, setNavigationWarningOpen] = useState(false);
  const [navigationWarningMessage, setNavigationWarningMessage] = useState('Lütfen girdiğiniz verileri kaydedin.');
  const [pendingSection, setPendingSection] = useState(null);
  const [deleteTargetUser, setDeleteTargetUser] = useState(null);
  const [newUserForm, setNewUserForm] = useState({ displayName: '', username: '', password: '', role: 'user' });
  const [passwordDrafts, setPasswordDrafts] = useState({});
  const [userPermissionDrafts, setUserPermissionDrafts] = useState({});
  const [pendingSetRows, setPendingSetRows] = useState({});
  const [newPersonName, setNewPersonName] = useState('');
  const [newPersonDate, setNewPersonDate] = useState(TODAY);
  const [newAccountCount, setNewAccountCount] = useState('10');
  const [newAccountNames, setNewAccountNames] = useState(DEFAULT_ACCOUNT_NAMES);
  const [blockDialogOpen, setBlockDialogOpen] = useState(false);
  const [selectedBlockItem, setSelectedBlockItem] = useState(null);
  const [resolvedAmountInput, setResolvedAmountInput] = useState('');
  const [pendingResolveMode, setPendingResolveMode] = useState('cozuldu');
  const [showResolvedAmountInput, setShowResolvedAmountInput] = useState(false);

  const canManage = currentUser?.role === 'admin';
  const hasUnsavedSetBilgiGirisi = useMemo(() => {
    const count = Number(newAccountCount || 0);
    const selectedNames = newAccountNames.slice(0, count);
    return newPersonName.trim() || newPersonDate !== TODAY || newAccountCount !== '10' || selectedNames.some((n, i) => (n || '').trim() !== (DEFAULT_ACCOUNT_NAMES[i] || '').trim());
  }, [newPersonName, newPersonDate, newAccountCount, newAccountNames]);

  function showActionNotice(title, message, tone = 'success') {
    setActionNotice({ open: true, title, message, tone });
    window.clearTimeout(window.__setNoticeTimer);
    window.__setNoticeTimer = window.setTimeout(() => setActionNotice((p) => ({ ...p, open: false })), 3000);
  }

  function hasUnsavedUserPanel() {
    const hasPasswordDraft = Object.values(passwordDrafts).some((v) => String(v || '').trim().length > 0);
    const hasPermissionDraft = Object.keys(userPermissionDrafts).length > 0;
    const hasNewUserDraft = !!(String(newUserForm.displayName || '').trim() || String(newUserForm.username || '').trim() || String(newUserForm.password || '').trim());
    return hasPasswordDraft || hasPermissionDraft || hasNewUserDraft;
  }

  function hasUnsavedAny() {
    return (activeSection === 'durum' && Object.keys(pendingSetRows).length > 0) ||
      (activeSection === 'giris' && hasUnsavedSetBilgiGirisi) ||
      (showUsersPanel && hasUnsavedUserPanel());
  }

  function getPanelUser(user) {
    return { ...user, ...(userPermissionDrafts[user.id] || {}) };
  }

  const dailyRows = historyByDay[selectedDay] || [];
  const displayedDailyRows = dailyRows.map((r) => pendingSetRows[r.id] || r);
  const visibleDailyRows = canManage ? displayedDailyRows : displayedDailyRows.filter((r) => !r.editedBy || r.editedBy === currentUser?.displayName);
  const visiblePeople = canManage ? people : people.filter((p) => visibleDailyRows.some((r) => r.personId === p.id));
  const selectedRows = visibleDailyRows.filter((r) => r.personId === selectedPersonId);
  const visibleBlocks = canManage ? blockCenter : blockCenter.filter((b) => b.createdBy === currentUser?.displayName);
  const activeUsers = canManage ? users.filter((u) => u.isActive) : users.filter((u) => u.id === currentUser?.id && u.isActive);
  const typingUsers = activeUsers.filter((u) => u.isTyping);

  const groupedTotals = useMemo(() => {
    const positive = visibleDailyRows.filter((r) => r.status === 'aktif' || r.status === 'nfc');
    const negative = visibleDailyRows.filter((r) => r.status === 'bloke' || r.status === 'sifre_kilit');
    const closed = visibleBlocks.filter((b) => b.resultList === 'kapandi');
    const activated = visibleBlocks.filter((b) => b.resultList === 'aktif_alindi');
    return {
      positiveAmount: positive.reduce((s, r) => s + Number(r.amount || 0), 0),
      positiveCount: positive.length + activated.length,
      negativeAmount: negative.reduce((s, r) => s + Number(r.amount || 0), 0),
      negativeCount: negative.length,
      closedCount: closed.length,
      closedAmount: closed.reduce((s, r) => s + Number(r.resolvedAmount || r.amount || 0), 0),
      activatedCount: activated.length,
      activatedAmount: activated.reduce((s, r) => s + Number(r.resolvedAmount || r.amount || 0), 0),
    };
  }, [visibleDailyRows, visibleBlocks]);

  const blockSummary = useMemo(() => {
    const resolved = visibleBlocks.filter((r) => r.resolution === 'cozuldu');
    const unresolved = visibleBlocks.filter((r) => r.resolution === 'cozulmedi');
    return {
      resolvedCount: resolved.length,
      resolvedAmount: resolved.reduce((s, r) => s + Number(r.resolvedAmount || r.amount || 0), 0),
      unresolvedCount: unresolved.length,
      unresolvedAmount: unresolved.reduce((s, r) => s + Number(r.amount || 0), 0),
    };
  }, [visibleBlocks]);

  const personTotals = useMemo(() => ({
    totalAmount: selectedRows.reduce((s, r) => s + Number(r.amount || 0), 0),
    activeAmount: selectedRows.filter((r) => r.status === 'aktif' || r.status === 'nfc').reduce((s, r) => s + Number(r.amount || 0), 0),
    lockedAmount: selectedRows.filter((r) => r.status === 'bloke' || r.status === 'sifre_kilit').reduce((s, r) => s + Number(r.amount || 0), 0),
    totalCount: selectedRows.length,
  }), [selectedRows]);

  const chartDailyTrend = useMemo(() => {
    return Object.keys(historyByDay).sort().slice(-7).map((day) => {
      const rows = historyByDay[day] || [];
      return {
        day: day.slice(5),
        aktif: rows.filter((r) => r.status === 'aktif' || r.status === 'nfc').reduce((s, r) => s + Number(r.amount || 0), 0),
        bloke: rows.filter((r) => r.status === 'bloke' || r.status === 'sifre_kilit').reduce((s, r) => s + Number(r.amount || 0), 0),
      };
    });
  }, [historyByDay]);

  const chartStatusMix = useMemo(() => {
    const rows = visibleDailyRows;
    return [
      { name: 'Aktif', value: rows.filter((r) => r.status === 'aktif').length },
      { name: 'NFC', value: rows.filter((r) => r.status === 'nfc').length },
      { name: 'Bloke', value: rows.filter((r) => r.status === 'bloke').length },
      { name: 'Şifre Kilit', value: rows.filter((r) => r.status === 'sifre_kilit').length },
      { name: 'Pasif', value: rows.filter((r) => r.status === 'pasif').length },
    ];
  }, [visibleDailyRows]);

  const generalSummaryDetails = useMemo(() => ({
    positive: visibleDailyRows.filter((r) => r.status === 'aktif' || r.status === 'nfc'),
    negative: visibleDailyRows.filter((r) => r.status === 'bloke' || r.status === 'sifre_kilit'),
    activated: visibleBlocks.filter((b) => b.resultList === 'aktif_alindi'),
    closed: visibleBlocks.filter((b) => b.resultList === 'kapandi'),
  }), [visibleDailyRows, visibleBlocks]);

  const filteredBlocks = useMemo(() => {
    if (!filter.trim()) return visibleBlocks;
    return visibleBlocks.filter((b) => `${b.personName} ${b.accountName} ${b.note} ${b.type}`.toLowerCase().includes(filter.toLowerCase()));
  }, [filter, visibleBlocks]);

  const pieColors = ['#0f766e', '#0891b2', '#e11d48', '#d97706', '#94a3b8'];

  useEffect(() => {
    try { localStorage.setItem(STORAGE_USERS, JSON.stringify(users)); } catch {}
  }, [users]);

  useEffect(() => {
    if (!currentUser) return;
    const refreshed = users.find((u) => u.id === currentUser.id);
    if (!refreshed) setCurrentUser(null);
    else if (refreshed !== currentUser) setCurrentUser(refreshed);
  }, [users, currentUser]);

  useEffect(() => {
    const handler = (e) => {
      if (hasUnsavedAny()) {
        e.preventDefault();
        e.returnValue = '';
      }
    };
    window.addEventListener('beforeunload', handler);
    return () => window.removeEventListener('beforeunload', handler);
  }, [activeSection, pendingSetRows, hasUnsavedSetBilgiGirisi, showUsersPanel, passwordDrafts, userPermissionDrafts, newUserForm]);

  function ensureDay(day) {
    if (historyByDay[day]) return;
    setHistoryByDay((prev) => ({ ...prev, [day]: makeDayRecords(people) }));
  }

  function startNewDay() {
    const today = getTurkeyNow().date;
    if (historyByDay[today]) { setSelectedDay(today); return; }
    const sourceRows = historyByDay[selectedDay] || [];
    const carryStatuses = new Set(['aktif', 'nfc', 'bloke', 'sifre_kilit']);
    setHistoryByDay((prev) => ({
      ...prev,
      [today]: sourceRows.map((row) => ({
        ...row,
        amount: carryStatuses.has(row.status) ? Number(row.amount || 0) : 0,
        status: carryStatuses.has(row.status) ? row.status : 'pasif',
        note: carryStatuses.has(row.status) ? row.note || '' : '',
        editedBy: '',
        editedAt: '',
      })),
    }));
    setSelectedDay(today);
    setPendingSetRows({});
  }

  function handleLogin() {
    const found = users.find((u) => u.username === login.username && u.password === login.password && u.twoFA === login.twoFA);
    if (!found) return alert('Giriş bilgileri hatalı.');
    if (!found.isActive) return alert('Bu kullanıcı pasif durumda.');
    setCurrentUser(found);
  }

  function updateRow(rowId, key, value) {
    if (!currentUser || (!currentUser.canEnterData && currentUser.role !== 'admin')) return;
    const currentRow = (historyByDay[selectedDay] || []).find((r) => r.id === rowId);
    const base = pendingSetRows[rowId] || currentRow;
    if (!base) return;
    setPendingSetRows((prev) => ({
      ...prev,
      [rowId]: { ...base, [key]: value, editedBy: currentUser.displayName, editedAt: getTurkeyNow().dateTime },
    }));
  }

  function saveSetDurumu() {
    if (!Object.keys(pendingSetRows).length) return;
    const now = getTurkeyNow();
    const newBlocks = [];
    const nextRows = (historyByDay[selectedDay] || []).map((row) => {
      const nextRow = pendingSetRows[row.id];
      if (!nextRow) return row;
      const wasBlocked = ['bloke', 'sifre_kilit'].includes(row.status);
      const isBlocked = ['bloke', 'sifre_kilit'].includes(nextRow.status);
      if (!wasBlocked && isBlocked) {
        const exists = blockCenter.some((b) => b.personName === row.personName && b.accountName === row.accountName && b.resultList === 'merkez');
        if (!exists) {
          newBlocks.push({ id: `b-${Date.now()}-${Math.random()}`, date: now.date, personName: row.personName, accountName: row.accountName, amount: Number(nextRow.amount || 0), type: nextRow.status, note: nextRow.note || '', resolution: 'cozulmedi', resultList: 'merkez', createdBy: currentUser.displayName });
        }
      }
      return { ...nextRow, editedBy: nextRow.editedBy || currentUser.displayName, editedAt: nextRow.editedAt || now.dateTime };
    });
    setHistoryByDay((prev) => ({ ...prev, [selectedDay]: nextRows }));
    if (newBlocks.length) setBlockCenter((prev) => [...newBlocks, ...prev]);
    setPendingSetRows({});
    setNavigationWarningOpen(false);
    if (pendingSection && pendingSection !== 'logout') {
      setActiveSection(pendingSection);
      setPendingSection(null);
    } else if (pendingSection === 'logout') {
      setPendingSection(null);
      setCurrentUser(null);
    }
  }

  function addPerson() {
    if (!newPersonName.trim() || !newPersonDate) return;
    const count = Number(newAccountCount || 0);
    const finalNames = newAccountNames.slice(0, count).map((n) => n.trim().toUpperCase());
    if (finalNames.some((n) => !n)) return alert('Seçilen hesap sayısı kadar isim girin.');
    const id = `p-${Date.now()}`;
    const person = { id, fullName: newPersonName.toUpperCase(), startDate: newPersonDate, accountNames: finalNames };
    setPeople((prev) => [...prev, person]);
    setHistoryByDay((prev) => ({ ...prev, [selectedDay]: [...(prev[selectedDay] || []), ...person.accountNames.map((accountName, i) => ({ id: `${id}-${i + 1}`, personId: id, personName: person.fullName, accountName, amount: 0, status: 'pasif', note: '', editedBy: '', editedAt: '' }))] }));
    setNewPersonName(''); setNewPersonDate(TODAY); setNewAccountCount('10'); setNewAccountNames(DEFAULT_ACCOUNT_NAMES);
  }

  function handleSectionChange(nextSection) {
    if (nextSection === activeSection) return;
    if (activeSection === 'durum' && Object.keys(pendingSetRows).length > 0) {
      setPendingSection(nextSection);
      setNavigationWarningMessage('Lütfen girdiğiniz verileri kaydedin.');
      setNavigationWarningOpen(true);
      return;
    }
    if (activeSection === 'giris' && hasUnsavedSetBilgiGirisi) {
      setPendingSection(nextSection);
      setNavigationWarningMessage('Lütfen şahıs bilgilerini ve tüm hesap isimlerini kaydedin.');
      setNavigationWarningOpen(true);
      return;
    }
    setActiveSection(nextSection);
  }

  function handleLogout() {
    if (showUsersPanel && hasUnsavedUserPanel()) {
      showActionNotice('Kaydetmeden çıkamazsınız', 'Önce kullanıcı panelindeki değişiklikleri kaydedin.', 'danger');
      return;
    }
    if (hasUnsavedAny()) {
      setPendingSection('logout');
      setNavigationWarningMessage('Lütfen girdiğiniz verileri kaydedin.');
      setNavigationWarningOpen(true);
      return;
    }
    setCurrentUser(null);
  }

  function toggleUser(userId, key) {
    setUserPermissionDrafts((prev) => {
      const sourceUser = users.find((u) => u.id === userId);
      const currentDraft = prev[userId] || { isActive: sourceUser?.isActive, canEnterData: sourceUser?.canEnterData };
      return { ...prev, [userId]: { ...currentDraft, [key]: !currentDraft[key] } };
    });
  }

  function saveUserRow(userId) {
    const nextPassword = String(passwordDrafts[userId] || '').trim();
    const permissionDraft = userPermissionDrafts[userId];
    const targetUser = users.find((u) => u.id === userId);
    if (!targetUser) return;
    if (!nextPassword && !permissionDraft) return;
    setUsers((prev) => prev.map((u) => u.id === userId ? { ...u, ...(permissionDraft || {}), ...(nextPassword ? { password: nextPassword } : {}) } : u));
    setPasswordDrafts((prev) => ({ ...prev, [userId]: '' }));
    setUserPermissionDrafts((prev) => { const next = { ...prev }; delete next[userId]; return next; });
    showActionNotice('Kaydedildi', `${targetUser.displayName} için değişiklikler kaydedildi.`);
  }

  function createNewUser() {
    const displayName = newUserForm.displayName.trim().toUpperCase();
    const username = newUserForm.username.trim().toLowerCase();
    const password = newUserForm.password.trim();
    if (!displayName || !username || !password) return alert('Yeni kullanıcı için ad, kullanıcı adı ve şifre zorunlu.');
    if (users.some((u) => u.username.toLowerCase() === username)) return alert('Bu kullanıcı adı zaten var.');
    const generatedTwoFA = String(Math.floor(100000 + Math.random() * 900000));
    setUsers((prev) => [...prev, { id: `u-${Date.now()}`, username, password, twoFA: generatedTwoFA, displayName, role: newUserForm.role, isActive: true, canEnterData: true, isTyping: false }]);
    setNewUserForm({ displayName: '', username: '', password: '', role: 'user' });
    showActionNotice('Kullanıcı oluşturuldu', `${displayName} eklendi. 2FA kodu: ${generatedTwoFA}`);
  }

  function deleteUser(userId) {
    const user = users.find((u) => u.id === userId);
    if (!user || user.role === 'admin') return;
    setDeleteTargetUser(user);
  }

  function confirmDeleteUser() {
    if (!deleteTargetUser) return;
    const targetId = deleteTargetUser.id;
    const targetName = deleteTargetUser.displayName;
    setUsers((prev) => prev.filter((u) => u.id !== targetId));
    setUserPermissionDrafts((prev) => { const next = { ...prev }; delete next[targetId]; return next; });
    setPasswordDrafts((prev) => { const next = { ...prev }; delete next[targetId]; return next; });
    setDeleteTargetUser(null);
    showActionNotice('Kullanıcı silindi', `${targetName} sistemden kaldırıldı.`, 'danger');
  }

  function saveUserPanelChanges() {
    const passwordEntries = Object.entries(passwordDrafts).filter(([, v]) => String(v || '').trim());
    let nextUsers = users.map((u) => ({ ...u, ...(userPermissionDrafts[u.id] || {}) }));
    const updatedNames = [];
    for (const [userId, passwordValue] of passwordEntries) {
      const targetUser = nextUsers.find((u) => u.id === userId);
      if (!targetUser) continue;
      targetUser.password = String(passwordValue).trim();
      updatedNames.push(targetUser.displayName);
    }
    const hasNewUserDraft = !!(String(newUserForm.displayName || '').trim() || String(newUserForm.username || '').trim() || String(newUserForm.password || '').trim());
    let createdUserName = '';
    if (hasNewUserDraft) {
      const displayName = newUserForm.displayName.trim().toUpperCase();
      const username = newUserForm.username.trim().toLowerCase();
      const password = newUserForm.password.trim();
      if (!displayName || !username || !password) return false;
      if (nextUsers.some((u) => u.username.toLowerCase() === username)) return false;
      const generatedTwoFA = String(Math.floor(100000 + Math.random() * 900000));
      nextUsers.push({ id: `u-${Date.now()}`, username, password, twoFA: generatedTwoFA, displayName, role: newUserForm.role, isActive: true, canEnterData: true, isTyping: false });
      createdUserName = displayName;
      setNewUserForm({ displayName: '', username: '', password: '', role: 'user' });
    }
    setUsers(nextUsers);
    setPasswordDrafts({});
    setUserPermissionDrafts({});
    if (updatedNames.length || createdUserName) showActionNotice('Kullanıcı bölümü kaydedildi', `${updatedNames.length ? `${updatedNames.length} şifre güncellendi` : ''}${updatedNames.length && createdUserName ? ' ve ' : ''}${createdUserName ? `${createdUserName} eklendi` : ''}.`);
    return true;
  }

  function handleWarningSaveAndContinue() {
    if (showUsersPanel && hasUnsavedUserPanel()) {
      const ok = saveUserPanelChanges();
      if (!ok) return alert('Kullanıcı panelindeki formu tamamlamadan devam edemezsiniz.');
      setNavigationWarningOpen(false);
      if (pendingSection === 'logout') { setPendingSection(null); setShowUsersPanel(false); setCurrentUser(null); return; }
      if (pendingSection === 'close_users_panel' || !pendingSection) { setPendingSection(null); setShowUsersPanel(false); return; }
      setShowUsersPanel(false); setActiveSection(pendingSection); setPendingSection(null); return;
    }
    if (activeSection === 'giris') { addPerson(); return; }
    saveSetDurumu();
  }

  function sendNotification() {
    setNotificationModalOpen(true);
  }

  function openBlockResolution(item) {
    setSelectedBlockItem(item);
    setResolvedAmountInput(String(item.resolvedAmount || item.amount || 0));
    setPendingResolveMode('cozuldu');
    setShowResolvedAmountInput(false);
    setBlockDialogOpen(true);
  }

  function setBlockAsResolved(mode = 'cozuldu') {
    if (!selectedBlockItem) return;
    if (mode !== 'cozulmedi' && !showResolvedAmountInput) {
      setPendingResolveMode(mode); setShowResolvedAmountInput(true); return;
    }
    const resolvedAmount = Number(resolvedAmountInput || 0);
    setBlockCenter((prev) => prev.map((b) => {
      if (b.id !== selectedBlockItem.id) return b;
      if (mode === 'aktif_alindi') return { ...b, resolution: 'cozuldu', resultList: 'aktif_alindi', resolvedAmount };
      if (mode === 'kapandi') return { ...b, resolution: 'cozuldu', resultList: 'kapandi', resolvedAmount };
      if (mode === 'cozulmedi') return { ...b, resolution: 'cozulmedi', resultList: 'merkez', resolvedAmount: 0 };
      return { ...b, resolution: 'cozuldu', resultList: 'merkez', resolvedAmount };
    }));
    setBlockDialogOpen(false); setSelectedBlockItem(null); setResolvedAmountInput(''); setShowResolvedAmountInput(false);
  }

  if (!currentUser) {
    return (
      <div className="login-shell">
        <div className="login-card card">
          <div className="login-title"><ShieldCheck size={28} /> WEB YÖNETİM GİRİŞİ</div>
          <div className="muted">Masaüstü kullanıma uygun, kurumsal web paneli</div>
          <label>Kullanıcı Adı</label>
          <input className="field" value={login.username} onChange={(e) => setLogin({ ...login, username: e.target.value })} />
          <label>Şifre</label>
          <input className="field" type="password" value={login.password} onChange={(e) => setLogin({ ...login, password: e.target.value })} />
          <label>2FA Kodu</label>
          <input className="field" value={login.twoFA} onChange={(e) => setLogin({ ...login, twoFA: e.target.value })} />
          <button className="btn btn-primary block" onClick={handleLogin}>GİRİŞ YAP</button>
          <div className="hint">Demo: admin / admin123 / 000111</div>
        </div>
      </div>
    );
  }

  return (
    <div className="app-shell">
      <aside className="sidebar card">
        <div className="sidebar-title">SET YÖNETİM PANELİ</div>
        <div className="muted">Web tabanlı profesyonel takip ekranı</div>
        <button className={`sidebar-btn ${activeSection === 'genel' ? 'active' : ''}`} onClick={() => handleSectionChange('genel')}><LayoutDashboard size={16} /> Genel Özet</button>
        <button className={`sidebar-btn ${activeSection === 'durum' ? 'active' : ''}`} onClick={() => handleSectionChange('durum')}><PieChartIcon size={16} /> Set Durumu</button>
        <button className={`sidebar-btn ${activeSection === 'bloke' ? 'active' : ''}`} onClick={() => handleSectionChange('bloke')}><AlertTriangle size={16} /> Bloke Takibi</button>
        <button className={`sidebar-btn ${activeSection === 'giris' ? 'active' : ''}`} onClick={() => handleSectionChange('giris')}><UserRound size={16} /> Set Bilgi Girişi</button>
        <div className="session-box">
          <div className="mini-label">OTURUM</div>
          <div className="session-name">{currentUser.displayName}</div>
          <div className="muted small">{currentUser.role === 'admin' ? 'YÖNETİCİ' : 'KULLANICI'}</div>
          <div className="muted small">Saat dilimi: Adana / Türkiye (UTC+3)</div>
          <button className="btn btn-outline block" onClick={handleLogout}>ÇIKIŞ YAP</button>
        </div>
      </aside>

      <main className="main-content">
        <div className="card topbar">
          <div>
            <div className="mini-label">RAPOR GÜNÜ</div>
            <div className="row-wrap mt8">
              <input className="field" type="date" value={selectedDay} onChange={(e) => { ensureDay(e.target.value); setSelectedDay(e.target.value); }} />
              <button className="btn btn-outline" onClick={startNewDay}>YENİ GÜNE BAŞLA</button>
              {canManage && (
                <>
                  <button className="btn btn-outline" onClick={() => alert('Genel rapor için EXCEL') }><FileSpreadsheet size={16}/> EXCEL</button>
                  <button className="btn btn-outline" onClick={() => alert('Genel rapor için PDF') }><FileText size={16}/> PDF</button>
                </>
              )}
            </div>
            <div className="live-box mt12">
              {typingUsers.length > 0 ? <><span className="live-dot" /> {typingUsers.map((u) => u.displayName).join(', ')} veri giriyor</> : <><span className="idle-dot" /> Aktif veri girişi yok</>}
            </div>
          </div>
          <div className="row-wrap">
            <button className="btn btn-primary" onClick={sendNotification}><BellRing size={16}/> BİLDİRİM GÖNDER</button>
            {canManage && <button className="btn btn-outline" onClick={() => setShowUsersPanel(true)}><Settings size={16}/> KULLANICILAR</button>}
          </div>
        </div>

        {activeSection === 'genel' && (
          <>
            <div className="summary-grid">
              <SummaryCard title="AKTİF + NFC BAKİYE" value={formatMoney(groupedTotals.positiveAmount)} subtitle={`Hesap sayısı: ${groupedTotals.positiveCount}`} onClick={() => setSelectedGeneralSummary('positive')} tone="teal" />
              <SummaryCard title="BLOKE + ŞİFRE KİLİT" value={formatMoney(groupedTotals.negativeAmount)} subtitle={`Hesap sayısı: ${groupedTotals.negativeCount}`} onClick={() => setSelectedGeneralSummary('negative')} tone="rose" />
              <SummaryCard title="AKTİFE ALINAN HESAPLAR" value={groupedTotals.activatedCount} subtitle={`Aktife alınan tutar: ${formatMoney(groupedTotals.activatedAmount)}`} onClick={() => setSelectedGeneralSummary('activated')} tone="cyan" />
              <SummaryCard title="KAPANAN HESAPLAR" value={groupedTotals.closedCount} subtitle={`Kapanan hesap tutarı: ${formatMoney(groupedTotals.closedAmount)}`} onClick={() => setSelectedGeneralSummary('closed')} />
            </div>
            <div className="charts-grid">
              <div className="card chart-card">
                <div className="section-title">GÜNLÜK BAKİYE TRENDİ</div>
                <div className="muted">Son günlerde aktif ve bloke dağılımı</div>
                <div className="chart-wrap">
                  <ResponsiveContainer width="100%" height="100%">
                    <AreaChart data={chartDailyTrend}>
                      <CartesianGrid strokeDasharray="3 3" />
                      <XAxis dataKey="day" />
                      <YAxis />
                      <Tooltip formatter={(value) => formatMoney(value)} />
                      <Area type="monotone" dataKey="aktif" stroke="#0f766e" fill="#99f6e4" strokeWidth={2} />
                      <Area type="monotone" dataKey="bloke" stroke="#e11d48" fill="#fecdd3" strokeWidth={2} />
                    </AreaChart>
                  </ResponsiveContainer>
                </div>
              </div>
              <div className="card chart-card">
                <div className="section-title">DURUM DAĞILIMI</div>
                <div className="muted">Güncel kayıtların durum karışımı</div>
                <div className="chart-wrap">
                  <ResponsiveContainer width="100%" height="100%">
                    <PieChart>
                      <Pie data={chartStatusMix} dataKey="value" nameKey="name" innerRadius={60} outerRadius={95} paddingAngle={2}>
                        {chartStatusMix.map((entry, index) => <Cell key={entry.name} fill={pieColors[index % pieColors.length]} />)}
                      </Pie>
                      <Tooltip />
                    </PieChart>
                  </ResponsiveContainer>
                </div>
              </div>
            </div>
          </>
        )}

        {activeSection === 'durum' && (
          <>
            <div className="card section-card">
              <div className="row-between align-end">
                <div>
                  <label>ŞAHIS SEÇ</label>
                  <select className="field" value={selectedPersonId} onChange={(e) => setSelectedPersonId(e.target.value)}>
                    {visiblePeople.map((p) => <option key={p.id} value={p.id}>{p.fullName}</option>)}
                  </select>
                </div>
                <div className="summary-grid compact">
                  <SummaryCard title="TOPLAM BAKİYE" value={formatMoney(personTotals.totalAmount)} subtitle={`Toplam hesap sayısı: ${personTotals.totalCount}`} />
                  <SummaryCard title="AKTİF + NFC" value={formatMoney(personTotals.activeAmount)} subtitle="Olumlu durum" tone="teal" />
                  <SummaryCard title="BLOKE + ŞİFRE KİLİT" value={formatMoney(personTotals.lockedAmount)} subtitle="Olumsuz durum" tone="rose" />
                </div>
              </div>
            </div>
            <div className="card section-card">
              <div className="section-title">DETAYLI HESAP TABLOSU</div>
              <div className="muted">Web düzenine uygun sabit başlıklı tablo görünümü</div>
              <div className="table-wrap mt16">
                <div className="table-head account-table">
                  <div>HESAP</div><div>TUTAR</div><div>DURUM</div><div>NOT</div><div>SON DURUM</div><div>KULLANICI / TARİH</div>
                </div>
                <div className="table-body max520">
                  {selectedRows.map((row) => {
                    const liveRow = pendingSetRows[row.id] || row;
                    const isPending = !!pendingSetRows[row.id];
                    return (
                      <div className={`table-row account-table ${isPending ? 'pending' : ''}`} key={row.id}>
                        <div className="strong">{liveRow.accountName}</div>
                        <input className="field" type="number" value={liveRow.amount} onChange={(e) => updateRow(row.id, 'amount', e.target.value)} />
                        <select className="field" value={liveRow.status} onChange={(e) => updateRow(row.id, 'status', e.target.value)}>
                          <option value="pasif">PASİF</option>
                          <option value="aktif">AKTİF</option>
                          <option value="nfc">NFC</option>
                          <option value="sifre_kilit">ŞİFRE KİLİT</option>
                          <option value="bloke">BLOKE</option>
                        </select>
                        <input className="field" value={liveRow.note} onChange={(e) => updateRow(row.id, 'note', e.target.value)} placeholder="Not" />
                        <div><StatusBadge status={liveRow.status} /></div>
                        <div className="info-box right"><div className="strong">{liveRow.editedBy || '-'}</div><div className="muted small">{liveRow.editedAt || '-'}</div></div>
                      </div>
                    );
                  })}
                </div>
              </div>
              <div className="row-end mt16"><button className="btn btn-primary" onClick={saveSetDurumu}>KAYDET</button></div>
            </div>
          </>
        )}

        {activeSection === 'giris' && (
          <div className="split-grid">
            <div className="card section-card">
              <div className="section-title">SET BİLGİ GİRİŞ</div>
              <div className="muted">Yeni eklenen tüm hesaplar başlangıçta pasif oluşturulur.</div>
              <div className="grid-3 mt16">
                <div><label>AD SOYAD</label><input className="field" value={newPersonName} onChange={(e) => setNewPersonName(e.target.value)} /></div>
                <div><label>HESAP SAYISI</label><select className="field" value={newAccountCount} onChange={(e) => { const value = e.target.value; setNewAccountCount(value); const count = Number(value); setNewAccountNames((prev) => { const next = [...prev]; while (next.length < count) next.push(`${String.fromCharCode(65 + (next.length % 26))} HESABI`); return next; }); }}>{Array.from({ length: 20 }, (_, i) => <option key={i + 1} value={String(i + 1)}>{i + 1} HESAP</option>)}</select></div>
                <div><label>TARİH</label><input className="field" type="date" value={newPersonDate} onChange={(e) => setNewPersonDate(e.target.value)} /></div>
              </div>
              <div className="subpanel mt16">
                <div className="subpanel-title">HESAP İSİMLERİ</div>
                <div className="grid-2">
                  {newAccountNames.slice(0, Number(newAccountCount)).map((name, index) => (
                    <div key={index}><label>{index + 1}. HESAP</label><input className="field" value={name} onChange={(e) => setNewAccountNames((prev) => prev.map((item, i) => i === index ? e.target.value : item))} /></div>
                  ))}
                </div>
              </div>
              <div className="row-end mt16"><button className="btn btn-primary" onClick={addPerson}><Plus size={16} /> KAYDET</button></div>
            </div>
            <div className="card section-card">
              <div className="section-title">ŞAHIS LİSTESİ</div>
              <div className="muted">Web düzeninde kartlı hızlı erişim listesi</div>
              <div className="stack mt16">
                {(canManage ? people : visiblePeople).map((person) => (
                  <div className="list-card" key={person.id}>
                    <div className="row-between"><div><div className="strong">{person.fullName}</div><div className="muted">Tarih: {person.startDate || '-'}</div></div><span className="small-chip">{person.accountNames.length} hesap</span></div>
                    <button className="btn btn-outline mt12" onClick={() => { setSelectedPersonId(person.id); setActiveSection('durum'); }}>HESAPLARI AÇ</button>
                  </div>
                ))}
              </div>
            </div>
          </div>
        )}

        {activeSection === 'bloke' && (
          <>
            <div className="summary-grid">
              <SummaryCard title="AÇIK BLOKE SAYISI" value={blockSummary.unresolvedCount} subtitle={`Toplam bloke: ${formatMoney(blockSummary.unresolvedAmount)}`} tone="rose" />
              <SummaryCard title="ÇÖZÜLEN BLOKE SAYISI" value={blockSummary.resolvedCount} subtitle={`Çözülen bakiye: ${formatMoney(blockSummary.resolvedAmount)}`} tone="cyan" />
              <SummaryCard title="KAPANAN HESAPLAR" value={visibleBlocks.filter((b) => b.resultList === 'kapandi').length} subtitle="Ayrı listede" />
              <SummaryCard title="AKTİFE ALINANLAR" value={visibleBlocks.filter((b) => b.resultList === 'aktif_alindi').length} subtitle="Ayrı listede" tone="teal" />
            </div>
            <div className="card section-card">
              <div className="section-title">BLOKE MERKEZİ</div>
              <div className="muted">Tüm günlerdeki bloke kayıtları burada tutulur</div>
              <div className="row-between mt16">
                <div className="search-box"><Search size={16} /><input className="field search-field" value={filter} onChange={(e) => setFilter(e.target.value)} placeholder="Şahıs, hesap, not, durum" /></div>
                {canManage && <div className="row-wrap"><button className="btn btn-outline" onClick={() => alert('Bloke EXCEL')}><FileSpreadsheet size={16}/> EXCEL</button><button className="btn btn-outline" onClick={() => alert('Bloke PDF')}><FileText size={16}/> PDF</button></div>}
              </div>
              <div className="table-wrap mt16">
                <div className="table-head block-table"><div>KAYIT</div><div>TUTAR</div><div>DURUM</div><div>SONUÇ</div><div>İŞLEM</div></div>
                <div className="table-body max520">
                  {filteredBlocks.length === 0 ? <div className="empty">KAYIT YOK</div> : filteredBlocks.map((item) => (
                    <div className="table-row block-table" key={item.id}>
                      <div><div className="strong">{item.personName} • {item.accountName}</div><div className="muted small">{item.date} • {item.createdBy} • {item.note || 'Not yok'}</div></div>
                      <div className="strong">{formatMoney(item.amount)}</div>
                      <div><StatusBadge status={item.type} /></div>
                      <div className={`strong ${item.resolution === 'cozulmedi' ? 'text-danger' : 'text-success'}`}>{item.resolution === 'cozulmedi' ? 'ÇÖZÜLMEDİ' : 'ÇÖZÜLDÜ'}</div>
                      <div><button className="btn btn-outline" onClick={() => openBlockResolution(item)}>DURUM GÜNCELLE</button></div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </>
        )}
      </main>

      <OverlayModal open={showUsersPanel && canManage} onClose={() => {
        if (hasUnsavedUserPanel()) { showActionNotice('Kaydetmeden çıkamazsınız', 'Önce kullanıcı panelindeki değişiklikleri kaydedin.', 'danger'); return; }
        setShowUsersPanel(false);
      }} title="KULLANICI YÖNETİMİ" maxWidth={1200}>
        <div className="subpanel">
          <div className="subpanel-title">YENİ KULLANICI OLUŞTUR</div>
          <div className="user-create-grid">
            <div><label>AD SOYAD</label><input className="field" placeholder="Ad Soyad" value={newUserForm.displayName} onChange={(e) => setNewUserForm((p) => ({ ...p, displayName: e.target.value }))} /></div>
            <div><label>KULLANICI ADI</label><input className="field" placeholder="Kullanıcı adı" value={newUserForm.username} onChange={(e) => setNewUserForm((p) => ({ ...p, username: e.target.value }))} /></div>
            <div><label>ŞİFRE</label><input className="field" type="password" placeholder="Şifre" value={newUserForm.password} onChange={(e) => setNewUserForm((p) => ({ ...p, password: e.target.value }))} /></div>
            <div><label>ROL</label><select className="field" value={newUserForm.role} onChange={(e) => setNewUserForm((p) => ({ ...p, role: e.target.value }))}><option value="user">KULLANICI</option><option value="admin">YÖNETİCİ</option></select></div>
            <div className="row-end"><button className="btn btn-primary" onClick={createNewUser}><Plus size={16}/> OLUŞTUR</button></div>
          </div>
        </div>
        <div className="table-wrap mt16">
          <div className="table-head user-table"><div>KULLANICI</div><div>ROL</div><div>DURUM</div><div>YETKİ</div><div>ŞİFRE / İŞLEM</div></div>
          <div className="table-body max460">
            {users.map((u) => {
              const panelUser = getPanelUser(u);
              return (
                <div className="table-row user-table" key={u.id}>
                  <div><div className="strong ellipsis">{u.displayName}</div><div className="muted small">{u.username} • 2FA: {u.twoFA}</div></div>
                  <div className="strong muted2">{u.role === 'admin' ? 'YÖNETİCİ' : 'KULLANICI'}</div>
                  <div className="toggle-line"><input type="checkbox" checked={panelUser.isActive} disabled={u.role === 'admin'} onChange={() => toggleUser(u.id, 'isActive')} /><span>{panelUser.isActive ? 'AKTİF' : 'PASİF'}</span></div>
                  <div className="toggle-line"><input type="checkbox" checked={panelUser.canEnterData} disabled={u.role === 'admin'} onChange={() => toggleUser(u.id, 'canEnterData')} /><span>VERİ GİRİŞİ</span></div>
                  <div className="row-wrap">
                    <input className="field" type="password" placeholder="Yeni şifre" value={passwordDrafts[u.id] || ''} onChange={(e) => setPasswordDrafts((p) => ({ ...p, [u.id]: e.target.value }))} />
                    <button className="btn btn-outline" onClick={() => saveUserRow(u.id)}>KAYDET</button>
                    {u.role !== 'admin' && <button className="btn btn-danger" onClick={() => deleteUser(u.id)}>SİL</button>}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </OverlayModal>

      <OverlayModal open={!!deleteTargetUser} onClose={() => setDeleteTargetUser(null)} title="KULLANICIYI SİL" maxWidth={520}>
        <div className="warning-box danger">{deleteTargetUser ? `${deleteTargetUser.displayName} kullanıcısı sistemden tamamen silinecek. Bu işlem geri alınamaz.` : ''}</div>
        <div className="row-end mt16 gap8"><button className="btn btn-outline" onClick={() => setDeleteTargetUser(null)}>İPTAL</button><button className="btn btn-danger" onClick={confirmDeleteUser}>TAMAMEN SİL</button></div>
      </OverlayModal>

      <OverlayModal open={notificationModalOpen} onClose={() => setNotificationModalOpen(false)} title="VERİ GİRİŞ UYARISI" maxWidth={560}>
        <div className="warning-box danger center big">Verileri 00.00’dan önce girin.</div>
        <div className="muted center">Bu bildirim dikkat çekici ses ile birlikte gönderilir.</div>
        <div className="row-center mt16"><button className="btn btn-danger" onClick={() => setNotificationModalOpen(false)}>TAMAM</button></div>
      </OverlayModal>

      <OverlayModal open={navigationWarningOpen} onClose={() => { setNavigationWarningOpen(false); setPendingSection(null); }} title="KAYDEDİLMEMİŞ VERİ UYARISI" maxWidth={560}>
        <div className="warning-box">{navigationWarningMessage}</div>
        <div className="row-end mt16 gap8">
          <button className="btn btn-outline" onClick={() => { setNavigationWarningOpen(false); setPendingSection(null); }}>Sayfada kal</button>
          {!(showUsersPanel && hasUnsavedUserPanel()) && <button className="btn btn-danger" onClick={() => {
            if (pendingSection === 'logout') { setNavigationWarningOpen(false); setPendingSection(null); setPendingSetRows({}); setCurrentUser(null); return; }
            setPendingSetRows({}); setNavigationWarningOpen(false); if (pendingSection) { setActiveSection(pendingSection); setPendingSection(null); }
          }}>Kaydetmeden çık</button>}
          <button className="btn btn-primary" onClick={handleWarningSaveAndContinue}>Kaydet ve devam et</button>
        </div>
      </OverlayModal>

      <OverlayModal open={blockDialogOpen} onClose={() => setBlockDialogOpen(false)} title="DURUM GÜNCELLEME" maxWidth={560}>
        {selectedBlockItem && <>
          <div className="info-box"><div className="strong">{selectedBlockItem.personName} • {selectedBlockItem.accountName}</div><div className="muted">Tutar: {formatMoney(selectedBlockItem.amount)}</div><div className="muted">Durum: {selectedBlockItem.type === 'sifre_kilit' ? 'Şifre kilit' : 'Bloke'}</div></div>
          <div className="stack mt16">
            <button className="btn btn-primary" onClick={() => setBlockAsResolved('cozuldu')}>ÇÖZÜLDÜ</button>
            {showResolvedAmountInput && <div className="subpanel"><label>ÇÖZÜLEN MİKTAR</label><input className="field mt8" type="number" value={resolvedAmountInput} onChange={(e) => setResolvedAmountInput(e.target.value)} /><div className="row-wrap mt12"><button className="btn btn-primary" onClick={() => setBlockAsResolved(pendingResolveMode)}>KAYDET</button><button className="btn btn-outline" onClick={() => { setShowResolvedAmountInput(false); setPendingResolveMode('cozuldu'); }}>İPTAL</button></div></div>}
            {selectedBlockItem.type === 'sifre_kilit' && <button className="btn btn-outline" onClick={() => setBlockAsResolved('aktif_alindi')}>ŞİFRESİ ÇÖZÜLDÜ • HESAP AKTİF</button>}
            {selectedBlockItem.type === 'bloke' && <button className="btn btn-outline" onClick={() => setBlockAsResolved('kapandi')}>ÇÖZÜLDÜ • HESAP KAPANDI</button>}
            <button className="btn btn-danger" onClick={() => setBlockAsResolved('cozulmedi')}>ÇÖZÜLMEDİ OLARAK BIRAK</button>
          </div>
        </>}
      </OverlayModal>

      <OverlayModal open={!!selectedGeneralSummary} onClose={() => setSelectedGeneralSummary(null)} title={
        selectedGeneralSummary === 'positive' ? 'AKTİF + NFC DETAYLI ÖZET' :
        selectedGeneralSummary === 'negative' ? 'BLOKE + ŞİFRE KİLİT DETAYLI ÖZET' :
        selectedGeneralSummary === 'activated' ? 'AKTİFE ALINAN HESAPLAR DETAYLI ÖZETİ' : 'KAPANAN HESAPLAR DETAYLI ÖZETİ'
      } maxWidth={920}>
        <div className="stack">
          {selectedGeneralSummary === 'positive' && generalSummaryDetails.positive.map((item) => <div key={item.id} className="detail-row teal"><div><div className="strong">{item.personName} • {item.accountName}</div><div className="muted small">{item.editedBy || '-'} • {item.editedAt || '-'}</div></div><div><StatusBadge status={item.status} /></div><div className="strong right">{formatMoney(item.amount)}</div></div>)}
          {selectedGeneralSummary === 'negative' && generalSummaryDetails.negative.map((item) => <div key={item.id} className="detail-row rose"><div><div className="strong">{item.personName} • {item.accountName}</div><div className="muted small">{item.note || 'NOT YOK'} • {item.editedAt || '-'}</div></div><div><StatusBadge status={item.status} /></div><div className="strong right">{formatMoney(item.amount)}</div></div>)}
          {selectedGeneralSummary === 'activated' && generalSummaryDetails.activated.map((item) => <div key={item.id} className="detail-row cyan"><div><div className="strong">{item.personName} • {item.accountName}</div><div className="muted small">{item.date} • {item.createdBy}</div></div><div className="strong right">{formatMoney(item.resolvedAmount || item.amount)}</div></div>)}
          {selectedGeneralSummary === 'closed' && generalSummaryDetails.closed.map((item) => <div key={item.id} className="detail-row"><div><div className="strong">{item.personName} • {item.accountName}</div><div className="muted small">{item.date} • {item.createdBy}</div></div><div className="strong right">{formatMoney(item.resolvedAmount || item.amount)}</div></div>)}
        </div>
      </OverlayModal>

      {actionNotice.open && <div className={`toast ${actionNotice.tone === 'danger' ? 'danger' : 'success'}`}><div className="strong">{actionNotice.title}</div><div>{actionNotice.message}</div></div>}
    </div>
  );
}
